<Window x:Class="CheckMail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка почты Exchange"
        Icon="app.ico"
        Width="480"
        Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Проверка почты Exchange (EWS)"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <!-- Форма настроек -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">

            <TextBlock x:Name="EwsUrlLabel" Text="EWS URL (например: https://mail.cit.gov.ru/EWS/Exchange.asmx):"/>
            <TextBox x:Name="EwsUrlBox" Margin="0,4,0,10"/>

            <TextBlock Text="Протокол проверки:"/>
            <ComboBox x:Name="ProtocolCombo" Margin="0,4,0,10" SelectionChanged="ProtocolCombo_SelectionChanged">
                <ComboBoxItem Content="IMAP"/>
                <ComboBoxItem Content="EWS"/>
            </ComboBox>

            <TextBlock x:Name="ImapServerLabel" Text="IMAP-сервер (например: mail.cit.gov.ru):"/>
            <TextBox x:Name="ImapServerBox" Margin="0,4,0,10"/>

            <StackPanel x:Name="ImapPortPanel" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Порт:" VerticalAlignment="Center"/>
                <TextBox x:Name="ImapPortBox" Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ImapSslCheck" Content="SSL/TLS" Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
            </StackPanel>

            <CheckBox x:Name="ImapRevocationCheck" Margin="0,0,0,10"
                      Content="Не проверять отзыв сертификата (для закрытой сети)"/>

            <TextBlock x:Name="ExcludedFoldersLabel" Text="Исключить папки (через запятую):"/>
            <TextBox x:Name="ExcludedFoldersBox" Margin="0,4,0,10"
                     ToolTip="Папки, письма в которых не учитываются. По умолчанию: Conflicts"/>

            <TextBlock Text="E-mail почтового ящика:"/>
            <TextBox x:Name="EmailBox" Margin="0,4,0,10"/>

            <TextBlock x:Name="AuthLabel" Text="Аутентификация:"/>
            <ComboBox x:Name="AuthCombo" Margin="0,4,0,10" SelectedIndex="0">
                <ComboBoxItem Content="Логин/пароль"/>
                <ComboBoxItem Content="Windows (Kerberos/NTLM)"/>
            </ComboBox>

            <TextBlock Text="Логин (если отличается от e-mail):"/>
            <TextBox x:Name="UsernameBox" Margin="0,4,0,10"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10"/>

            <TextBlock Text="Домен (необязательно):"/>
            <TextBox x:Name="DomainBox" Margin="0,4,0,10"/>

            <TextBlock Text="Интервал проверки (минут):"/>
            <ComboBox x:Name="IntervalCombo" Margin="0,4,0,12">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="30"/>
            </ComboBox>

            <CheckBox x:Name="AllFoldersCheck" Content="Проверять все папки (включая вложенные) и подпапки"
                      Margin="0,0,0,4"/>
            <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows" Margin="0,2,0,2"/>
        </StackPanel>

        <!-- Статус -->
        <GroupBox Grid.Row="2" Header="Статус" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Остановлено" TextWrapping="Wrap" Margin="8"/>
                <TextBlock x:Name="LastRunText" Text="" TextWrapping="Wrap" Margin="8,0,8,4" Foreground="#FF777777"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestBtn" Content="Проверить" Width="90" Height="32" Margin="0,0,8,0" Click="Test_Click"/>
            <Button x:Name="StartBtn" Content="Запустить" Width="100" Height="32" Margin="0,0,8,0" Click="Start_Click"/>
            <Button x:Name="StopBtn" Content="Остановить" Width="100" Height="32" IsEnabled="False" Click="Stop_Click"/>
        </StackPanel>
    </Grid>
</Window>
